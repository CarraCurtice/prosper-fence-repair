{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^prosper-fence-repair\\.vercel\\.app$"
        }
      ],
      "destination": "https://prosperfencerepair.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^www\\.prosperfencerepair\\.com$"
        }
      ],
      "destination": "https://prosperfencerepair.com/:path*",
      "permanent": true
    }
  ]
}
